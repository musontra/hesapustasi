---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Birincil (latin) font dosyaları — preload için. Vite hash'ler ve
// global.css'teki @font-face url()'leriyle aynı varlığa çözülür.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
// Türkçe gövde karakterleri (İ, ş, ğ, ç …) Inter'de latin-ext alt kümesinde;
// gövde FOUT'unu azaltmak için bu dosyayı da öne al.
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
// Türkçe başlık karakterleri (İ, ş, Ğ, ç …) latin-ext alt kümesinde; başlıklar
// Fraunces ile çizildiğinden bu dosyayı da öne al (H1/title FOUT'unu azaltır).
import frauncesLatinExt from '@fontsource-variable/fraunces/files/fraunces-latin-ext-wght-normal.woff2?url';

interface Props {
  /** Sayfaya özgü <title> (SEO — her sayfa benzersiz olmalı) */
  title: string;
  /** Sayfaya özgü meta açıklama (SEO) */
  description: string;
  /** true ise sayfa indekslenmez (örn. "yakında" sayfaları) */
  noindex?: boolean;
  /** Sosyal paylaşım görseli (1200×630). Verilmezse varsayılan kullanılır. */
  ogImage?: string;
}
const { title, description, noindex = false, ogImage = '/og-default.png' } = Astro.props;

const siteOrigin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = new URL(ogImage, siteOrigin).href;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Sayfalar arası akıcı client-side geçiş -->
    <ViewTransitions />
    <!-- Reveal'ın ilk boyamada gizlenebilmesi için işaret; reduced-motion'da
         eklenmez (öğeler direkt görünür kalır). is:inline → boyamadan önce çalışır. -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
      }
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Birincil fontları erkenden indir (LCP/FOUT iyileştirmesi) -->
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={interLatinExt} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={frauncesLatin} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={frauncesLatinExt} crossorigin="anonymous" />

    <!-- Open Graph (sosyal paylaşım) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#1B2A4A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal'ı her gezinmede (ve ilk yükte) yeni DOM için başlat.
      import { initReveal } from '../scripts/reveal';
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
