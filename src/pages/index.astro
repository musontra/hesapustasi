---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import CalcIcon from '../components/CalcIcon.astro';
import { calculators } from '../data/calculators';
import { guncelDonem } from '../data/oranlar';

// Aktifler önce, "yakında"lar sonra — kategori içinde sırala.
const sirala = (a: typeof calculators) =>
  [...a].sort((x, y) => Number(y.status === 'aktif') - Number(x.status === 'aktif'));

const hesaplayicilar = sirala(calculators.filter((c) => c.category === 'hesaplayici'));
const donusturucular = sirala(calculators.filter((c) => c.category === 'donusturucu'));

// Hero'daki hızlı erişim listesi — en çok kullanılan araçlar.
const sikKullanilanSluglar = ['kira-artisi', 'kidem-tazminati-hesaplama', 'yillik-izin-hesaplama', 'cm-inc-cevirme'];
const sikKullanilanlar = sikKullanilanSluglar
  .map((slug) => calculators.find((c) => c.slug === slug && c.status === 'aktif'))
  .filter((c) => c !== undefined);

const oranBicim = new Intl.NumberFormat('tr-TR', {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
---

<BaseLayout
  title="HesapAtölyesi — Güncel Hesaplama Araçları"
  description="Kira artışı, kıdem ve ihbar tazminatı, yıllık izin… Türkiye için hızlı, sade ve güncel hesaplama araçları tek çatı altında."
>
  <!-- Hero — araç odaklı: solda mesaj, sağda hızlı erişim (1 saniyede araca ulaş) -->
  <section class="container-x grid items-center gap-8 pb-16 pt-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 sm:pt-24">
    <div class="animate-fade-up">
      <p class="eyebrow">Hesaplama Araçları Merkezi</p>
      <h1 class="mt-4 text-balance text-4xl leading-[1.08] tracking-tightest sm:text-5xl lg:text-6xl">
        Kira artışından kıdem tazminatına, doğru hesap tek yerde.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        Resmî oranlarla her ay güncellenen, hızlı ve sade araçlar. Karmaşık
        formüllerle uğraşmayın — sonucu saniyeler içinde, anlaşılır biçimde alın.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/kira-artisi" class="btn-gold">Kira Artışını Hesapla</a>
        <a href="#araclar" class="btn-ghost">Tüm araçları gör</a>
      </div>
    </div>

    <!-- Hızlı erişim kartı — gerçek araçlar, gerçek güncel oran -->
    <aside class="surface animate-fade-up p-6 sm:p-8" aria-labelledby="hizli-erisim-baslik">
      <div class="flex items-center justify-between gap-4">
        <h2 id="hizli-erisim-baslik" class="text-lg tracking-tight">Sık kullanılanlar</h2>
        <span class="rounded-full bg-gold-500/15 px-3 py-1 text-xs font-semibold text-gold-300">
          TÜFE %{oranBicim.format(guncelDonem.oran)}
        </span>
      </div>
      <ul class="mt-4 divide-y divide-ink-600/40">
        {sikKullanilanlar.map((c) => (
          <li>
            <a href={`/${c.slug}`} class="group flex min-h-[48px] items-center gap-3 py-3 transition">
              <span class="grid h-8 w-8 flex-none place-items-center rounded-lg border border-lacivert/15 bg-lacivert/5 text-lacivert transition group-hover:bg-gold-500/10 group-hover:text-gold-300">
                <CalcIcon name={c.icon} class="h-4 w-4" />
              </span>
              <span class="flex-1 text-sm font-medium text-cream transition group-hover:text-gold-300">{c.title}</span>
              <svg class="h-4 w-4 text-muted transition-transform duration-300 group-hover:translate-x-1 group-hover:text-gold-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-4 border-t border-ink-600/40 pt-4 text-xs leading-relaxed text-muted">
        Kira artışında {guncelDonem.donem} dönemi yasal tavanı: 12 aylık ortalama
        TÜFE, %{oranBicim.format(guncelDonem.oran)} (TÜİK).
      </p>
    </aside>
  </section>

  <!-- Hesaplama araçları — kırık simetri: öne çıkan araç geniş hücrede -->
  <section id="araclar" class="container-x scroll-mt-24 pt-16 sm:pt-24">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-3xl tracking-tight sm:text-4xl" data-reveal>Hesaplama Araçları</h2>
      <p class="hidden text-sm text-muted sm:block">Düzenli olarak yenisi eklenir.</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {hesaplayicilar.map((calc, i) => (
        <CalculatorCard calc={calc} index={i} featured={i === 0} />
      ))}
    </div>
  </section>

  <!-- Birim dönüştürücüler — ikincil araçlar, kompakt eş kartlar -->
  <section id="donusturucular" class="container-x scroll-mt-24 pt-16 sm:pt-24">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-3xl tracking-tight sm:text-4xl" data-reveal>Birim Dönüştürücüler</h2>
      <p class="hidden text-sm text-muted sm:block">Anında, çift yönlü dönüşüm.</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {donusturucular.map((calc, i) => <CalculatorCard calc={calc} index={i} />)}
    </div>
  </section>
</BaseLayout>
