---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorShell from '../components/CalculatorShell.astro';
import ComingSoon from '../components/ComingSoon.astro';
import Disclaimer from '../components/Disclaimer.astro';
---

<BaseLayout
  title="İhbar Tazminatı Hesaplama — Yakında"
  description="Kıdeminize göre ihbar süresi ve ihbar tazminatı hesaplama aracı çok yakında HesapAtölyesi'nde."
  noindex={true}
>
  <CalculatorShell
    baslik="İhbar Tazminatı Hesaplama"
    ozet="Kıdeminize göre ihbar süresini ve ihbar tazminatı tutarını öğrenin."
  >
    <div class="mx-auto max-w-2xl space-y-6">
      <ComingSoon />
      <Disclaimer />
    </div>
  </CalculatorShell>
</BaseLayout>
