---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorShell from '../components/CalculatorShell.astro';
import ComingSoon from '../components/ComingSoon.astro';
import Disclaimer from '../components/Disclaimer.astro';
---

<BaseLayout
  title="Kıdem Tazminatı Hesaplama — Yakında"
  description="Çalışma sürenize ve brüt ücretinize göre kıdem tazminatı hesaplama aracı çok yakında HesapAtölyesi'nde."
  noindex={true}
>
  <CalculatorShell
    baslik="Kıdem Tazminatı Hesaplama"
    ozet="Çalışma sürenize ve brüt ücretinize göre kıdem tazminatınızı hesaplayın."
  >
    <div class="mx-auto max-w-2xl space-y-6">
      <ComingSoon />
      <Disclaimer />
    </div>
  </CalculatorShell>
</BaseLayout>
