---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import Faq from '../../components/Faq.astro';
import type { FaqItem } from '../../components/Faq.astro';
import { dhbtTestler, duzeyler, sonGuncelleme, kaynak } from '../../data/sinav';

const sss: FaqItem[] = [
  {
    soru: 'DHBT nedir?',
    cevap:
      'DHBT (Din Hizmetleri Alan Bilgisi Testi), Diyanet İşleri Başkanlığı ve din öğretimi kadrolarına başvuracak adaylar için ÖSYM tarafından KPSS ile birlikte yapılan alan bilgisi sınavıdır. Yerleştirme puanı, adayın KPSS Genel Yetenek-Genel Kültür sonuçları ile DHBT alan testleri birlikte değerlendirilerek oluşur.',
  },
  {
    soru: 'DHBT’de hangi testler ve kaç soru var?',
    cevap:
      'Değerlendirmeye giren dört test vardır: Genel Yetenek (60 soru), Genel Kültür (60 soru), DHBT-1 (20 soru) ve DHBT-2 (20 soru). Bu araç dört testin doğru ve yanlış sayısını alıp netlerinizi ve tahmini puanınızı hesaplar.',
  },
  {
    soru: 'Yanlış cevap doğruyu götürür mü?',
    cevap:
      'Evet. KPSS ve DHBT’de 4 yanlış 1 doğruyu götürür. Her test için net = doğru − (yanlış ⁄ 4) formülüyle bulunur; boş bıraktığınız sorular neti etkilemez.',
  },
  {
    soru: 'P122, P123 ve P124 arasındaki fark nedir?',
    cevap:
      'Bunlar öğrenim düzeyine göre hesaplanan puan türleridir: P122 ortaöğretim (lise), P123 önlisans, P124 lisans mezunları içindir. Netler aynı olsa bile düzeye göre kullanılan puan katsayıları farklı olduğundan sonuç değişebilir.',
  },
  {
    soru: 'Puan nasıl hesaplanır?',
    cevap:
      'Önce her testin neti bulunur, ardından bu netler kendi ağırlık katsayılarıyla çarpılıp bir taban puana eklenir. Genel Yetenek ve Genel Kültür ile DHBT-1 ve DHBT-2 farklı ağırlıklara sahiptir; bu yüzden alan testlerindeki (DHBT-1/DHBT-2) her net, puana daha güçlü yansır.',
  },
  {
    soru: 'Sonuç neden “tahmini”?',
    cevap:
      'Kullanılan katsayılar geçmiş yıl ÖSYM istatistiklerinden kalibre edilmiştir. Gerçek puan; sınavın zorluğu, o yılın standart sapması ve ÖSYM’nin resmi hesap yöntemine göre değişir. Bu araç yön göstericidir; kesin puanınız yalnızca ÖSYM sonuç belgesinde açıklanır.',
  },
];

// Formda dönen test satırları — tek kaynaktan (data/sinav) beslenir.
const testSatirlari = [
  { anahtar: 'gy', ad: dhbtTestler.GY.ad,    max: dhbtTestler.GY.soruSayisi },
  { anahtar: 'gk', ad: dhbtTestler.GK.ad,    max: dhbtTestler.GK.soruSayisi },
  { anahtar: 'd1', ad: dhbtTestler.DHBT1.ad, max: dhbtTestler.DHBT1.soruSayisi },
  { anahtar: 'd2', ad: dhbtTestler.DHBT2.ad, max: dhbtTestler.DHBT2.soruSayisi },
] as const;

const duzeySecenek = [
  { kod: 'P124', ad: duzeyler.P124 },
  { kod: 'P123', ad: duzeyler.P123 },
  { kod: 'P122', ad: duzeyler.P122 },
] as const;
---

<BaseLayout
  title="KPSS DHBT Puan Hesaplama 2026 | Lisans, Önlisans, Ortaöğretim"
  description="Her test için doğru ve yanlışınızı girin; GY, GK ve DHBT netlerinizle Lisans (P124), Önlisans (P123) veya Ortaöğretim (P122) tahmini KPSSP puanınızı anında hesaplayın."
>
  <CalculatorShell
    baslik="KPSS DHBT Puan Hesaplama"
    ozet="Öğrenim düzeyinizi seçin, her test için doğru ve yanlış sayınızı girin; netlerinizi ve tahmini KPSSP puanınızı anında görün."
    guncellemeGoster={true}
    guncellemeTarihi={sonGuncelleme}
  >
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
      <!-- Giriş -->
      <form id="dhbt-form" class="surface h-fit p-6 sm:p-7" novalidate>
        <h2 class="text-xl tracking-tight">Bilgileri girin</h2>

        <div class="mt-6 space-y-6">
          <!-- Öğrenim düzeyi seçici -->
          <fieldset>
            <legend class="block text-sm font-medium text-mist">Öğrenim düzeyi</legend>
            <div class="mt-2 grid grid-cols-3 gap-2" role="radiogroup" aria-label="Öğrenim düzeyi">
              {duzeySecenek.map((d, i) => (
                <label class="duzey-secim relative cursor-pointer">
                  <input
                    type="radio"
                    name="duzey"
                    value={d.kod}
                    class="peer sr-only"
                    checked={i === 0}
                  />
                  <span class="flex flex-col items-center justify-center rounded-xl border border-ink-600 bg-ink-900/60 px-2 py-3 text-center text-sm text-mist transition peer-checked:border-gold-500/60 peer-checked:bg-gold-500/10 peer-checked:text-cream peer-focus-visible:ring-2 peer-focus-visible:ring-gold-500/60">
                    <span class="font-medium">{d.ad}</span>
                    <span class="mt-0.5 text-[11px] text-muted">{d.kod}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Test girişleri -->
          <div>
            <div class="flex items-center justify-between text-xs text-muted">
              <span>Test</span>
              <span class="flex gap-6 pr-1"><span class="w-16 text-center">Doğru</span><span class="w-16 text-center">Yanlış</span></span>
            </div>
            <div class="mt-2 space-y-2.5">
              {testSatirlari.map((t) => (
                <div class="flex items-center justify-between gap-3 rounded-xl border border-ink-600/70 bg-ink-900/40 px-3.5 py-2.5">
                  <div class="min-w-0">
                    <span class="block truncate text-sm text-cream">{t.ad}</span>
                    <span class="text-[11px] text-muted">{t.max} soru</span>
                  </div>
                  <div class="flex flex-none gap-3">
                    <label class="sr-only" for={`${t.anahtar}Dogru`}>{t.ad} doğru sayısı</label>
                    <input
                      id={`${t.anahtar}Dogru`}
                      name={`${t.anahtar}Dogru`}
                      type="number"
                      inputmode="numeric"
                      min="0"
                      max={t.max}
                      step="1"
                      placeholder="0"
                      class="w-16 rounded-lg border border-ink-600 bg-ink-900/60 px-2.5 py-2 text-center text-cream focus:border-gold-500/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500/60 placeholder:text-muted/60"
                    />
                    <label class="sr-only" for={`${t.anahtar}Yanlis`}>{t.ad} yanlış sayısı</label>
                    <input
                      id={`${t.anahtar}Yanlis`}
                      name={`${t.anahtar}Yanlis`}
                      type="number"
                      inputmode="numeric"
                      min="0"
                      max={t.max}
                      step="1"
                      placeholder="0"
                      class="w-16 rounded-lg border border-ink-600 bg-ink-900/60 px-2.5 py-2 text-center text-cream focus:border-gold-500/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-500/60 placeholder:text-muted/60"
                    />
                  </div>
                </div>
              ))}
            </div>
            <p class="mt-2 text-xs text-muted">
              Boş bıraktığınız alan 0 sayılır. Doğru + yanlış, o testin soru sayısını aşamaz.
            </p>
          </div>

          <button type="submit" class="btn-gold w-full">Hesapla</button>
          <p id="dhbt-hata" class="hidden text-sm text-red-300" role="alert"></p>
        </div>
      </form>

      <!-- Sonuç -->
      <div class="space-y-6">
        <div
          id="sonuc-panel"
          class="surface relative overflow-hidden p-6 opacity-60 transition sm:p-8"
          aria-hidden="true"
        >
          <p id="eyebrow" class="eyebrow">Tahmini KPSSP puanı · <span id="eyebrow-duzey">Lisans (P124)</span></p>
          <p id="puan-wrap" class="mt-3 font-serif text-5xl tracking-tightest text-cream sm:text-6xl">
            <span id="sonuc-puan" aria-hidden="true">—</span>
          </p>

          <!-- Geçersiz girişte gösterilecek durum mesajı -->
          <p id="durum" class="hidden" aria-live="polite"></p>

          <!-- "Tahmini" çerçevesi — belirgin, gizlenmez -->
          <p id="tahmini-not" class="mt-4 flex items-start gap-2 rounded-lg border border-gold-500/25 bg-gold-500/[0.06] px-3.5 py-2.5 text-xs leading-relaxed text-mist">
            <svg class="mt-0.5 h-4 w-4 flex-none text-gold-500/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 8h.01M11 12h1v4h1" />
            </svg>
            <span>Bu puan geçmiş sınav istatistiklerine dayalı bir <strong class="font-semibold text-cream">tahmindir</strong>. Kesin sonuç yalnızca ÖSYM tarafından açıklanır.</span>
          </p>

          <!-- Net dökümü -->
          <dl id="dokum" class="mt-7 hidden space-y-3 text-sm">
            <div class="flex items-center justify-between">
              <dt class="text-muted">Genel Yetenek neti</dt>
              <dd id="net-gy" class="font-medium text-mist">—</dd>
            </div>
            <div class="flex items-center justify-between">
              <dt class="text-muted">Genel Kültür neti</dt>
              <dd id="net-gk" class="font-medium text-mist">—</dd>
            </div>
            <div class="flex items-center justify-between">
              <dt class="text-muted">DHBT-1 neti</dt>
              <dd id="net-d1" class="font-medium text-mist">—</dd>
            </div>
            <div class="flex items-center justify-between">
              <dt class="text-muted">DHBT-2 neti</dt>
              <dd id="net-d2" class="font-medium text-mist">—</dd>
            </div>
            <div class="hairline !border-ink-600/70 pt-3 flex items-center justify-between">
              <dt class="text-cream">Tahmini puan</dt>
              <dd id="d-puan" class="font-semibold text-gold-300">—</dd>
            </div>
          </dl>

          <button id="kopyala" type="button" class="btn-ghost mt-8 hidden">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="2" />
              <path d="M5 15V5a2 2 0 0 1 2-2h10" />
            </svg>
            <span id="kopyala-metin">Sonucu kopyala</span>
          </button>
        </div>

        <!-- Ekran okuyucu için nihai sonucu bir kez duyur -->
        <p id="sr-sonuc" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

        <!-- Nasıl hesaplandı -->
        <div class="surface p-6">
          <h2 class="text-lg tracking-tight text-cream">Nasıl hesaplanıyor?</h2>
          <p class="mt-3 text-sm leading-relaxed text-mist">
            Önce her testin neti bulunur (4 yanlış 1 doğruyu götürür), sonra netler
            kendi ağırlıklarıyla çarpılıp bir taban puana eklenir:
          </p>
          <p class="mt-3 rounded-lg border border-ink-600/60 bg-ink-900/50 px-4 py-3 text-sm text-cream">
            Net = Doğru − (Yanlış ⁄ 4) &nbsp;·&nbsp; Puan = Taban + (ağırlıklı netler toplamı)
          </p>
          <p class="mt-3 text-xs leading-relaxed text-muted">
            Katsayılar öğrenim düzeyine (P124/P123/P122) göre değişir. {kaynak} istatistiklerinden
            kalibre edilmiştir; sonuç tahminidir.
          </p>
        </div>

        <Disclaimer metin="Bu araç yalnızca bilgilendirme amaçlı bir tahmindir; resmi/hukuki değildir. Kesin puanınız yalnızca ÖSYM tarafından açıklanır." />

        <!-- Çapraz bağlantı -->
        <a href="/kira-artisi" class="surface flex items-center justify-between gap-4 p-5 transition hover:border-gold-500/40 hover:shadow-glow">
          <span class="text-sm text-mist">Diğer hesaplama araçlarına göz atın</span>
          <svg class="h-4 w-4 flex-none text-gold-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>

    <Faq items={sss} />
  </CalculatorShell>
</BaseLayout>

<script>
  import { dhbtPuanHesapla, type DhbtGirdi } from '../../lib/sinav';
  import { dhbtTestler, type DhbtDuzey } from '../../data/sinav';

  function initDhbt() {
    const form = document.getElementById('dhbt-form') as HTMLFormElement | null;
    if (!form) return;
    const $ = (id: string) => document.getElementById(id)!;
    const panel = $('sonuc-panel');
    const puanEl = $('sonuc-puan');
    const puanWrap = $('puan-wrap');
    const eyebrow = $('eyebrow');
    const eyebrowDuzey = $('eyebrow-duzey');
    const durum = $('durum');
    const tahminiNot = $('tahmini-not');
    const dokum = $('dokum');
    const netGy = $('net-gy');
    const netGk = $('net-gk');
    const netD1 = $('net-d1');
    const netD2 = $('net-d2');
    const dPuan = $('d-puan');
    const srSonuc = $('sr-sonuc');
    const kopyala = $('kopyala') as HTMLButtonElement;
    const kopyalaMetin = $('kopyala-metin');
    const hata = $('dhbt-hata');

    const azHareket = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let kopyalaMetni = '';
    let hesaplandi = false;

    const fmtPuan = (n: number) =>
      n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmtNet = (n: number) =>
      n.toLocaleString('tr-TR', { maximumFractionDigits: 2 });

    // Bir alanı sayıya çevir: boş → 0. NaN/negatif ise null (geçersiz).
    function alan(name: string): number | null {
      const ham = (form.elements.namedItem(name) as HTMLInputElement)?.value ?? '';
      if (ham.trim() === '') return 0;
      const v = Number(ham);
      if (!Number.isFinite(v) || v < 0) return null;
      return v;
    }

    function duzeySec(): DhbtDuzey {
      const el = form.querySelector('input[name="duzey"]:checked') as HTMLInputElement | null;
      return (el?.value as DhbtDuzey) ?? 'P124';
    }

    function countUp(el: HTMLElement, hedef: number) {
      if (azHareket) {
        el.textContent = fmtPuan(hedef);
        return;
      }
      const sure = 1100;
      const t0 = performance.now();
      function tick(now: number) {
        const p = Math.min(1, (now - t0) / sure);
        // easeOutExpo — premium, yumuşak yavaşlayarak biten eğri.
        const eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
        el.textContent = fmtPuan(hedef * eased);
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = fmtPuan(hedef);
      }
      requestAnimationFrame(tick);
    }

    // Geçersiz/eksik girişte önceki başarılı sonucu panelde bırakma.
    function sifirla() {
      hesaplandi = false;
      panel.classList.add('opacity-60');
      panel.setAttribute('aria-hidden', 'true');
      eyebrow.classList.add('hidden');
      puanWrap.classList.add('hidden');
      puanEl.textContent = '—';
      tahminiNot.classList.add('hidden');
      dokum.classList.add('hidden');
      durum.classList.add('hidden');
      kopyala.classList.add('hidden');
    }

    // Geçersiz girişte: paneli temizle (sifirla) ve tek bir uyarı göster.
    function sadeceDurum(mesaj: string) {
      sifirla();
      // Uyarı görünsün diye paneli tekrar aç (sifirla gizlemişti).
      panel.classList.remove('opacity-60');
      panel.removeAttribute('aria-hidden');
      durum.className = 'badge-warn';
      durum.textContent = mesaj;
      durum.classList.remove('hidden');
      srSonuc.textContent = mesaj;
    }

    const testler = [
      { d: 'gyDogru', y: 'gyYanlis', ad: dhbtTestler.GY.ad,    max: dhbtTestler.GY.soruSayisi },
      { d: 'gkDogru', y: 'gkYanlis', ad: dhbtTestler.GK.ad,    max: dhbtTestler.GK.soruSayisi },
      { d: 'd1Dogru', y: 'd1Yanlis', ad: dhbtTestler.DHBT1.ad, max: dhbtTestler.DHBT1.soruSayisi },
      { d: 'd2Dogru', y: 'd2Yanlis', ad: dhbtTestler.DHBT2.ad, max: dhbtTestler.DHBT2.soruSayisi },
    ] as const;

    function hesapla(animasyon: boolean) {
      hata.classList.add('hidden');

      // Tüm alanları oku + geçerlilik denetle.
      const girdi: Partial<DhbtGirdi> = { duzey: duzeySec() };
      for (const t of testler) {
        const dogru = alan(t.d);
        const yanlis = alan(t.y);
        if (dogru === null || yanlis === null) {
          sadeceDurum(`${t.ad}: doğru ve yanlış sayısı 0 veya daha büyük olmalıdır.`);
          return;
        }
        if (dogru + yanlis > t.max) {
          sadeceDurum(`${t.ad}: doğru + yanlış toplamı ${t.max} soruyu aşamaz.`);
          return;
        }
        (girdi as Record<string, number | DhbtDuzey>)[t.d] = dogru;
        (girdi as Record<string, number | DhbtDuzey>)[t.y] = yanlis;
      }

      let sonuc;
      try {
        sonuc = dhbtPuanHesapla(girdi as DhbtGirdi);
      } catch (e) {
        sadeceDurum(e instanceof Error ? e.message : 'Girdiğiniz değerler geçersiz.');
        return;
      }

      // Başarılı sonuç — paneli göster.
      hesaplandi = true;
      panel.classList.remove('opacity-60');
      panel.removeAttribute('aria-hidden');
      eyebrow.classList.remove('hidden');
      puanWrap.classList.remove('hidden');
      tahminiNot.classList.remove('hidden');
      dokum.classList.remove('hidden');
      durum.classList.add('hidden');
      kopyala.classList.remove('hidden');

      const duzeyEtiket = `${sonuc.duzeyAdi} (${sonuc.duzey})`;
      eyebrowDuzey.textContent = duzeyEtiket;

      if (animasyon) countUp(puanEl, sonuc.puan);
      else puanEl.textContent = fmtPuan(sonuc.puan);

      netGy.textContent = fmtNet(sonuc.netler.GY);
      netGk.textContent = fmtNet(sonuc.netler.GK);
      netD1.textContent = fmtNet(sonuc.netler.D1);
      netD2.textContent = fmtNet(sonuc.netler.D2);
      dPuan.textContent = fmtPuan(sonuc.puan);

      srSonuc.textContent = `Tahmini KPSS DHBT puanı (${duzeyEtiket}): ${fmtPuan(sonuc.puan)}.`;

      kopyalaMetni =
        `KPSS DHBT Puan Hesabı (tahmini)\n` +
        `Öğrenim düzeyi: ${duzeyEtiket}\n` +
        `Genel Yetenek neti: ${fmtNet(sonuc.netler.GY)}\n` +
        `Genel Kültür neti: ${fmtNet(sonuc.netler.GK)}\n` +
        `DHBT-1 neti: ${fmtNet(sonuc.netler.D1)}\n` +
        `DHBT-2 neti: ${fmtNet(sonuc.netler.D2)}\n` +
        `Tahmini puan: ${fmtPuan(sonuc.puan)}`;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      hesapla(true);
    });

    // Öğrenim düzeyi değişince, zaten bir sonuç varsa anında yeniden hesapla.
    form.querySelectorAll('input[name="duzey"]').forEach((r) =>
      r.addEventListener('change', () => {
        if (hesaplandi) hesapla(true);
      }),
    );

    kopyala.addEventListener('click', async () => {
      if (!kopyalaMetni) return;
      try {
        await navigator.clipboard.writeText(kopyalaMetni);
        kopyalaMetin.textContent = 'Kopyalandı ✓';
        setTimeout(() => (kopyalaMetin.textContent = 'Sonucu kopyala'), 1800);
      } catch {
        kopyalaMetin.textContent = 'Kopyalanamadı';
        setTimeout(() => (kopyalaMetin.textContent = 'Sonucu kopyala'), 1800);
      }
    });
  }

  document.addEventListener('astro:page-load', initDhbt);
</script>
