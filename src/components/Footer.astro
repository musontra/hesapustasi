---
const year = new Date().getFullYear();
import { calculators } from '../data/calculators';

const hesaplayicilar = calculators.filter((c) => c.category === 'hesaplayici');
const donusturucular = calculators.filter((c) => c.category === 'donusturucu');
---

<!-- Marka laciverti footer (skill.md: ana renk yapısal öğelerde) -->
<footer class="mt-24 bg-lacivert text-white">
  <div class="container-x grid gap-8 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <span class="font-serif text-lg text-white">Hesap<span class="text-gold-400">Atölyesi</span></span>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/70">
        Türkiye için hızlı, sade ve güvenilir hesaplama araçları. Her ay güncel
        oranlarla yenilenir.
      </p>
    </div>

    <div>
      <p class="eyebrow-inverse">Hesaplayıcılar</p>
      <ul class="mt-4 space-y-2 text-sm">
        {hesaplayicilar.map((c) => (
          <li>
            <a
              href={`/${c.slug}`}
              class="text-white/70 transition hover:text-gold-400"
            >
              {c.title}
              {c.status === 'yakinda' && (
                <span class="ml-1 text-xs text-white/50">(yakında)</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="eyebrow-inverse">Dönüştürücüler</p>
      <ul class="mt-4 space-y-2 text-sm">
        {donusturucular.map((c) => (
          <li>
            <a
              href={`/${c.slug}`}
              class="text-white/70 transition hover:text-gold-400"
            >
              {c.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="text-sm text-white/70">
      <p class="eyebrow-inverse">Bilgi</p>
      <p class="mt-4 leading-relaxed">
        Bu sitedeki araçlar yalnızca bilgilendirme amaçlıdır; yasal veya mali
        tavsiye niteliği taşımaz.
      </p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col items-center justify-between gap-2 py-6 text-xs text-white/60 sm:flex-row">
      <p>&copy; {year} HesapAtölyesi. Tüm hakları saklıdır.</p>
      <p>Sevgiyle ve dikkatle hazırlandı.</p>
    </div>
  </div>
</footer>
