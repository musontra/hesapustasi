---
// Hesaplayıcı ikonları — ince çizgili (stroke) inline SVG'ler.
// data/calculators.ts içindeki "icon" alanıyla eşleşir.
interface Props {
  name: 'kira' | 'kidem' | 'ihbar' | 'izin' | 'sinav' | 'uzunluk' | 'agirlik' | 'sicaklik';
  class?: string;
}
const { name, class: className = 'h-6 w-6' } = Astro.props;
---

{name === 'kira' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 11.5 12 4l9 7.5" />
    <path d="M5 10v9h14v-9" />
    <path d="M9.5 19v-5h5v5" />
  </svg>
)}
{name === 'kidem' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="7" width="18" height="13" rx="2" />
    <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
    <path d="M3 12h18" />
  </svg>
)}
{name === 'ihbar' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0-6 6c0 4-1.5 5.5-2 6.5h16c-.5-1-2-2.5-2-6.5a6 6 0 0 0-6-6Z" />
    <path d="M10 20a2 2 0 0 0 4 0" />
  </svg>
)}
{name === 'izin' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4.5" width="18" height="16" rx="2" />
    <path d="M3 9h18M8 3v3M16 3v3" />
    <path d="m8.5 14 2.5 2.5 4.5-4.5" />
  </svg>
)}
{name === 'sinav' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 4 2 9l10 5 10-5-10-5Z" />
    <path d="M6 11.2V16c0 1.2 2.7 2.6 6 2.6s6-1.4 6-2.6v-4.8" />
    <path d="M22 9v5.5" />
  </svg>
)}
{name === 'uzunluk' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2" y="7" width="20" height="10" rx="2" transform="rotate(0 12 12)" />
    <path d="M6 7v3M10 7v4M14 7v3M18 7v4" />
  </svg>
)}
{name === 'agirlik' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5 8h14l2 11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1L5 8Z" />
    <circle cx="12" cy="6" r="2.5" />
  </svg>
)}
{name === 'sicaklik' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14 14.5V5a2 2 0 0 0-4 0v9.5a4 4 0 1 0 4 0Z" />
    <path d="M12 9v6" />
  </svg>
)}
