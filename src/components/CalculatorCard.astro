---
import CalcIcon from './CalcIcon.astro';
import type { Calculator } from '../data/calculators';
interface Props {
  calc: Calculator;
  /** Kart sırası — scroll-reveal stagger gecikmesi için (opsiyonel) */
  index?: number;
}
const { calc, index = 0 } = Astro.props;
const aktif = calc.status === 'aktif';
const Tag = aktif ? 'a' : 'div';
// Dönüştürücüler için "Çevir", hesaplayıcılar için "Hesapla".
const eylem = calc.category === 'donusturucu' ? 'Çevir' : 'Hesapla';
---

<Tag
  href={aktif ? `/${calc.slug}` : undefined}
  data-reveal
  data-reveal-delay={(index % 3) * 90}
  class:list={[
    'group surface relative flex flex-col p-6 transition duration-300',
    aktif
      ? 'hover:-translate-y-1 hover:border-gold-500/40 hover:shadow-glow'
      : 'cursor-default opacity-60',
  ]}
  role={!aktif ? 'link' : undefined}
  aria-disabled={!aktif ? 'true' : undefined}
  aria-label={!aktif ? `${calc.title} — yakında, henüz kullanılamıyor` : undefined}
>
  {!aktif && (
    <span class="absolute right-5 top-5 rounded-full border border-ink-600 px-2.5 py-0.5 text-[10px] font-medium uppercase tracking-wider text-muted">
      Yakında
    </span>
  )}

  <span
    class:list={[
      'grid h-12 w-12 place-items-center rounded-xl border transition',
      aktif
        ? 'border-gold-500/30 bg-gold-500/10 text-gold-500 group-hover:bg-gold-500/20'
        : 'border-ink-600 bg-ink-700/50 text-muted',
    ]}
  >
    <CalcIcon name={calc.icon} />
  </span>

  <h3 class="mt-5 text-xl tracking-tight">{calc.title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-mist">{calc.description}</p>

  {aktif && (
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-gold-500">
      {eylem}
      <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
  )}
</Tag>
